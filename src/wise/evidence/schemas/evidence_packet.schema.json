{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-proposal"
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "norm_hash": {
          "type": "string",
          "minLength": 1
        },
        "data_hash": {
          "type": "string",
          "minLength": 1
        },
        "scoring_mode": {
          "enum": [
            "flat",
            "layer_balanced"
          ]
        },
        "observation_policy_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "commit",
        "norm_hash",
        "data_hash",
        "scoring_mode",
        "observation_policy_id"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "current_population",
            "historical",
            "target"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "layer_profile": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "baseline_id",
        "kind",
        "score",
        "layer_profile"
      ],
      "additionalProperties": false
    },
    "explanation_kind": {
      "enum": [
        "absolute_only",
        "absolute_and_reference_contrast"
      ]
    },
    "unit_type": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "in_scope": {
            "type": "boolean"
          },
          "evaluable": {
            "type": "boolean"
          },
          "violation": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "raw_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "raw_unit": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "witness_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "evidence_id",
          "unit_id",
          "constraint_id",
          "in_scope",
          "evaluable",
          "violation",
          "raw_value",
          "raw_unit",
          "reason",
          "witness_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "evaluable": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "violation": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "in_scope": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "evaluable": {
                  "const": false
                },
                "violation": {
                  "const": null
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "fact_id",
          "value",
          "unit",
          "description",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run",
    "baseline",
    "explanation_kind",
    "unit_type",
    "evidence",
    "facts",
    "qualifications"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed WISE evidence packet (not current API)",
  "allOf": [
    {
      "if": {
        "properties": {
          "baseline": {
            "properties": {
              "layer_profile": {
                "const": null
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "explanation_kind": {
            "const": "absolute_only"
          }
        }
      }
    }
  ]
}